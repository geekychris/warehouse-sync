{
  "name": "ProductsFullRefresh",
  "sync_id": "products_full_refresh",
  "version": "1.0.0",
  "description": "Small reference table synced by full snapshot each run — catches deletes and column edits without watermark bookkeeping.",

  "source": {
    "type": "postgres",
    "connection": {
      "host_env": "SOURCE_PG_HOST",
      "port_env": "SOURCE_PG_PORT",
      "database_env": "SOURCE_PG_DB",
      "user_env": "SOURCE_PG_USER",
      "password_env": "SOURCE_PG_PASSWORD"
    },
    "schema": "public",
    "table": "products",
    "columns": ["id", "sku", "name", "price_cents", "active"],
    "primary_key": ["id"]
  },

  "mode": "full_replace",

  "warehouse": {
    "table_name": "warehouse.public_products",
    "target_catalog": "iceberg"
  },

  "schedule": {
    "cadence": "1h",
    "batch_size": 100000
  }
}
